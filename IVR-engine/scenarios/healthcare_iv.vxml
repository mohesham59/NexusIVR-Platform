<?xml version="1.0" encoding="UTF-8"?>
<vxml version="2.1" xmlns="http://www.w3.org/2001/vxml">
  <meta name="flow-name" content="Telecom IVR"/>
  <!-- Start (n1) -->
  <form id="n1">
    <block>
      <prompt bargein="false" xml:lang="en">
        Welcome to Telecom Services. Press 1 for Billing. Press 2 for Roaming. Press 3 for Sim Support. Press 4 for Broadband. Press 0 to speak to an agent.
      </prompt>
      <goto next="#n2"/>
    </block>
  </form>
  <!-- Menu (n2) -->
  <menu id="n2">
      <prompt bargein="true" xml:lang="en">
        Please select an option.
      </prompt>
      <choice dtmf="1" next="#n3"/>
      <choice dtmf="2" next="#n4"/>
      <choice dtmf="3" next="#n5"/>
      <choice dtmf="4" next="#n6"/>
      <choice dtmf="0" next="#n7"/>
      <choice dtmf="6" next="#n8">End Call</choice>
      <choice dtmf="5" next="#n8"/>
      <noinput>
        <prompt xml:lang="en">We did not receive any input. Please try again.</prompt>
        <prompt xml:lang="ar">لم نتلق أي إدخال. يرجى المحاولة مرة أخرى.</prompt>
        <goto next="#n8"/>
      </noinput>
      <nomatch>
        <prompt xml:lang="en">Invalid option. Please try again.</prompt>
        <prompt xml:lang="ar">خيار غير صالح. يرجى المحاولة مرة أخرى.</prompt>
        <reprompt/>
      </nomatch>
  </menu>
  <!-- Billing (n3) -->
  <form id="n3">
    <block>
      <prompt bargein="false" xml:lang="en">
        Please hold while we connect you to Billing.
      </prompt>
      <transfer dest="Transfer the call to an agent or number"/>
      <goto next="#n8"/>
    </block>
  </form>
  <!-- Roaming (n4) -->
  <form id="n4">
    <block>
      <prompt bargein="false" xml:lang="en">
        Please hold while we connect you to Roaming.
      </prompt>
      <transfer dest="Transfer the call to an agent or number"/>
      <goto next="#n8"/>
    </block>
  </form>
  <!-- Sim support (n5) -->
  <form id="n5">
    <block>
      <prompt bargein="false" xml:lang="en">
        Please hold while we connect you to Sim Support.
      </prompt>
      <transfer dest="Transfer the call to an agent or number"/>
      <goto next="#n8"/>
    </block>
  </form>
  <!-- Broadband (n6) -->
  <form id="n6">
    <block>
      <prompt bargein="false" xml:lang="en">
        Please hold while we connect you to Broadband.
      </prompt>
      <transfer dest="Transfer the call to an agent or number"/>
      <goto next="#n8"/>
    </block>
  </form>
  <!-- Agent (n7) -->
  <form id="n7">
    <block>
      <prompt bargein="false" xml:lang="en">
        Please hold while we connect you to a representative.
      </prompt>
      <transfer dest="Transfer the call to an agent or number"/>
      <goto next="#n8"/>
    </block>
  </form>
  <!-- End Call (n8) -->
  <form id="n8">
    <block>
      <prompt bargein="false">Hang up</prompt>
      <disconnect/>
    </block>
  </form>
</vxml>