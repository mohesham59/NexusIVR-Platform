    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>SuperAdminDashboardServlet</servlet-name>
        <url-pattern>/api/v1/super-admin/dashboard/*</url-pattern>
    </servlet-mapping>

    <!-- System Health Servlet -->
    <servlet>
        <servlet-name>SystemHealthServlet</servlet-name>
        <servlet-class>com.nexusivr.ai.controller.SystemHealthServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SystemHealthServlet</servlet-name>
        <url-pattern>/api/v1/admin/system-health</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>SystemHealthServlet</servlet-name>
        <url-pattern>/api/v1/super-admin/system-health</url-pattern>
    </servlet-mapping>

    <!-- Audit Logs Servlet -->
    <servlet>
        <servlet-name>AuditLogsServlet</servlet-name>
        <servlet-class>com.nexusivr.ai.controller.AuditLogsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AuditLogsServlet</servlet-name>
        <url-pattern>/api/v1/admin/audit-logs</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
