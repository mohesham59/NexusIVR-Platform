    <servlet>
        <servlet-name>AiFunctionCallServlet</servlet-name>
        <servlet-class>com.nexusivr.ai.controller.AiFunctionCallServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AiFunctionCallServlet</servlet-name>
        <url-pattern>/api/v1/ai/function-call</url-pattern>
    </servlet-mapping>

    <!-- AI Conversation History Servlet -->
    <servlet>
        <servlet-name>AiConversationHistoryServlet</servlet-name>
        <servlet-class>com.nexusivr.ai.controller.AiConversationHistoryServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AiConversationHistoryServlet</servlet-name>
        <url-pattern>/api/v1/ai/history</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>AiConversationHistoryServlet</servlet-name>
        <url-pattern>/api/v1/ai/history/*</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>AiConversationHistoryServlet</servlet-name>
        <url-pattern>/api/v1/ai/conversation/*</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>AiConversationHistoryServlet</servlet-name>
        <url-pattern>/api/v1/ai/new-chat</url-pattern>
    </servlet-mapping>

    <!-- AI Analytics Servlet -->
    <servlet>
        <servlet-name>AiAnalyticsServlet</servlet-name>
        <servlet-class>com.nexusivr.ai.controller.AiAnalyticsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AiAnalyticsServlet</servlet-name>
        <url-pattern>/api/v1/ai/analytics</url-pattern>
    </servlet-mapping>

    <!-- Call Analytics Servlet -->
    <servlet>
        <servlet-name>CallAnalyticsServlet</servlet-name>
        <servlet-class>com.nexusivr.ai.controller.CallAnalyticsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CallAnalyticsServlet</servlet-name>
        <url-pattern>/api/v1/ai/analytics/calls</url-pattern>
    </servlet-mapping>

    <!-- CDR Analytics Servlet -->
    <servlet>
        <servlet-name>CdrServlet</servlet-name>
        <servlet-class>com.nexusivr.ai.controller.CdrServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CdrServlet</servlet-name>
        <url-pattern>/api/v1/ai/cdr/calls</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>CdrServlet</servlet-name>
        <url-pattern>/api/v1/ai/cdr/summary</url-pattern>
    </servlet-mapping>

    <!-- AI Prompts Servlet -->
    <servlet>
        <servlet-name>AiPromptsServlet</servlet-name>
        <servlet-class>com.nexusivr.ai.controller.AiPromptsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AiPromptsServlet</servlet-name>
        <url-pattern>/api/v1/ai/prompts</url-pattern>
    </servlet-mapping>

    <!-- AI Provider Servlet -->
    <servlet>
        <servlet-name>AiProviderServlet</servlet-name>
        <servlet-class>com.nexusivr.ai.controller.AiProviderServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AiProviderServlet</servlet-name>
        <url-pattern>/api/v1/ai/provider</url-pattern>
    </servlet-mapping>

    <!-- AI Provider List Servlet -->
    <servlet>
        <servlet-name>AiProviderListServlet</servlet-name>
        <servlet-class>com.nexusivr.ai.controller.AiProviderListServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AiProviderListServlet</servlet-name>
        <url-pattern>/api/v1/ai/providers</url-pattern>
    </servlet-mapping>

    <!-- AI Agent Servlet -->
    <servlet>
        <servlet-name>AiAgentServlet</servlet-name>
        <servlet-class>com.nexusivr.ai.controller.AiAgentServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AiAgentServlet</servlet-name>
        <url-pattern>/api/v1/ai/agents</url-pattern>
    </servlet-mapping>

    <!-- Voice Prompts Upload Servlet -->
    <servlet>
        <servlet-name>VoicePromptsUploadServlet</servlet-name>
        <servlet-class>com.nexusivr.ai.controller.VoicePromptsUploadServlet</servlet-class>
        <multipart-config>
            <max-file-size>52428800</max-file-size>
            <max-request-size>104857600</max-request-size>
            <file-size-threshold>2097152</file-size-threshold>
        </multipart-config>
    </servlet>
    <servlet-mapping>
        <servlet-name>VoicePromptsUploadServlet</servlet-name>
        <url-pattern>/api/v1/voice-prompts/upload</url-pattern>
    </servlet-mapping>

    <!-- Voice Prompts Stream Servlet -->
    <servlet>
        <servlet-name>VoicePromptsStreamServlet</servlet-name>
        <servlet-class>com.nexusivr.ai.controller.VoicePromptsStreamServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>VoicePromptsStreamServlet</servlet-name>
        <url-pattern>/api/v1/voice-prompts/stream</url-pattern>
    </servlet-mapping>

    <!-- Voice Prompts Generate Servlet -->
    <servlet>
        <servlet-name>VoicePromptsGenerateServlet</servlet-name>
        <servlet-class>com.nexusivr.ai.controller.VoicePromptsGenerateServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>VoicePromptsGenerateServlet</servlet-name>
        <url-pattern>/api/v1/voice-prompts/generate</url-pattern>
    </servlet-mapping>

    <!-- Browser TTS Preview (IVR Builder Test Simulator) - returns audio/mpeg -->
    <servlet>
        <servlet-name>TtsPreviewServlet</servlet-name>
        <servlet-class>com.nexusivr.ai.controller.TtsPreviewServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>TtsPreviewServlet</servlet-name>
        <url-pattern>/api/v1/tts/preview</url-pattern>
    </servlet-mapping>

    <!-- Notifications Servlet -->
    <servlet>
        <servlet-name>NotificationServlet</servlet-name>
        <servlet-class>com.nexusivr.ai.controller.NotificationServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>NotificationServlet</servlet-name>
        <url-pattern>/api/v1/notifications</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>NotificationServlet</servlet-name>
        <url-pattern>/api/v1/notifications/*</url-pattern>
    </servlet-mapping>
    <!-- Tenant Phone Numbers Servlet -->
    <servlet>
        <servlet-name>TenantPhoneNumberServlet</servlet-name>
        <servlet-class>com.nexusivr.ai.controller.TenantPhoneNumberServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>TenantPhoneNumberServlet</servlet-name>
        <url-pattern>/api/v1/tenant/phone-numbers</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>TenantPhoneNumberServlet</servlet-name>
        <url-pattern>/api/v1/tenant/phone-numbers/*</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>TenantPhoneNumberServlet</servlet-name>
        <url-pattern>/api/v1/tenant/published-flows</url-pattern>
    </servlet-mapping>

    <!-- Tenant SIP Extensions Servlet -->
    <servlet>
        <servlet-name>TenantSipExtensionServlet</servlet-name>
        <servlet-class>com.nexusivr.ai.controller.TenantSipExtensionServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>TenantSipExtensionServlet</servlet-name>
        <url-pattern>/api/v1/tenant/sip-extensions</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>TenantSipExtensionServlet</servlet-name>
        <url-pattern>/api/v1/tenant/sip-extensions/*</url-pattern>
    </servlet-mapping>

    <!-- Tenant Queues & Agents Servlet -->
    <servlet>
        <servlet-name>TenantQueueServlet</servlet-name>
        <servlet-class>com.nexusivr.ai.controller.TenantQueueServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>TenantQueueServlet</servlet-name>
        <url-pattern>/api/v1/queues</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>TenantQueueServlet</servlet-name>
        <url-pattern>/api/v1/queues/*</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>TenantQueueServlet</servlet-name>
        <url-pattern>/api/v1/agents</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>TenantQueueServlet</servlet-name>
        <url-pattern>/api/v1/agents/*</url-pattern>
    </servlet-mapping>

    <!-- Operations Dashboard Servlet -->
    <servlet>
        <servlet-name>DashboardServlet</servlet-name>
        <servlet-class>com.nexusivr.ai.controller.DashboardServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DashboardServlet</servlet-name>
        <url-pattern>/api/v1/dashboard/*</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>DashboardServlet</servlet-name>
        <url-pattern>/api/v1/calls/*</url-pattern>
    </servlet-mapping>

