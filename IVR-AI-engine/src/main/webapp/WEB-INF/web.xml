<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0"
         metadata-complete="true">

    <display-name>NexusIVR AI Backend Engine</display-name>

    <listener>
        <listener-class>com.nexusivr.ai.config.AppServletContextListener</listener-class>
    </listener>

    <!-- CORS Filter -->
    <filter>
        <filter-name>CorsFilter</filter-name>
        <filter-class>com.nexusivr.ai.config.CorsFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>CorsFilter</filter-name>
        <url-pattern>/api/*</url-pattern>
    </filter-mapping>

    <!-- Health Servlet -->
    <servlet>
        <servlet-name>HealthServlet</servlet-name>
        <servlet-class>com.nexusivr.ai.controller.HealthServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>HealthServlet</servlet-name>
        <url-pattern>/health</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>HealthServlet</servlet-name>
        <url-pattern>/api/v1/health</url-pattern>
    </servlet-mapping>

    <!-- Auth Servlet -->
    <servlet>
        <servlet-name>AuthServlet</servlet-name>
        <servlet-class>com.nexusivr.ai.controller.AuthServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AuthServlet</servlet-name>
        <url-pattern>/api/v1/auth/login</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>AuthServlet</servlet-name>
        <url-pattern>/api/v1/auth/me</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>AuthServlet</servlet-name>
        <url-pattern>/api/v1/auth/logout</url-pattern>
    </servlet-mapping>

    <!-- SuperAdmin Users Servlet -->
    <servlet>
        <servlet-name>SuperAdminUsersServlet</servlet-name>
        <servlet-class>com.nexusivr.ai.controller.SuperAdminUsersServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SuperAdminUsersServlet</servlet-name>
        <url-pattern>/api/v1/super-admin/users</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>SuperAdminUsersServlet</servlet-name>
        <url-pattern>/api/v1/super-admin/users/reset-password</url-pattern>
    </servlet-mapping>

    <!-- SuperAdmin Tenants/Companies Servlet -->
    <servlet>
        <servlet-name>SuperAdminTenantsServlet</servlet-name>
        <servlet-class>com.nexusivr.ai.controller.SuperAdminTenantsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SuperAdminTenantsServlet</servlet-name>
        <url-pattern>/api/v1/super-admin/companies</url-pattern>
    </servlet-mapping>

    <!-- Tenant Companies Servlet -->
    <servlet>
        <servlet-name>TenantCompaniesServlet</servlet-name>
        <servlet-class>com.nexusivr.ai.controller.TenantCompaniesServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>TenantCompaniesServlet</servlet-name>
        <url-pattern>/api/v1/tenant/companies</url-pattern>
    </servlet-mapping>

    <!-- AI Chat Servlet -->
    <servlet>
        <servlet-name>AiChatServlet</servlet-name>
        <servlet-class>com.nexusivr.ai.controller.AiChatServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AiChatServlet</servlet-name>
        <url-pattern>/api/v1/ai/chat</url-pattern>
    </servlet-mapping>

    <!-- AI Flow Servlet -->
    <servlet>
        <servlet-name>AiFlowServlet</servlet-name>
        <servlet-class>com.nexusivr.ai.controller.AiFlowServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AiFlowServlet</servlet-name>
        <url-pattern>/api/v1/ai/flow/generate</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>AiFlowServlet</servlet-name>
        <url-pattern>/api/v1/ai/flow/improve</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>AiFlowServlet</servlet-name>
        <url-pattern>/api/v1/ai/flow/validate</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>AiFlowServlet</servlet-name>
        <url-pattern>/api/v1/ai/flow/*</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>AiFlowServlet</servlet-name>
        <url-pattern>/api/v1/ai/generation/*</url-pattern>
    </servlet-mapping>

    <!-- AI Summarize Servlet -->
    <servlet>
        <servlet-name>AiSummarizeServlet</servlet-name>
        <servlet-class>com.nexusivr.ai.controller.AiSummarizeServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AiSummarizeServlet</servlet-name>
        <url-pattern>/api/v1/ai/summarize</url-pattern>
    </servlet-mapping>

    <!-- AI Sentiment Servlet -->
    <servlet>
        <servlet-name>AiSentimentServlet</servlet-name>
        <servlet-class>com.nexusivr.ai.controller.AiSentimentServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AiSentimentServlet</servlet-name>
        <url-pattern>/api/v1/ai/sentiment</url-pattern>
    </servlet-mapping>

