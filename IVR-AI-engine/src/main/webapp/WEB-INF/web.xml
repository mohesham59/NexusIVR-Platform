        <servlet-class>com.nexusivr.ai.controller.SuperAdminDashboardServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SuperAdminDashboardServlet</servlet-name>
        <url-pattern>/api/v1/admin/platform-stats</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>SuperAdminDashboardServlet</servlet-name>
        <url-pattern>/api/v1/admin/company-growth</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>SuperAdminDashboardServlet</servlet-name>
        <url-pattern>/api/v1/admin/ai-requests-today</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
