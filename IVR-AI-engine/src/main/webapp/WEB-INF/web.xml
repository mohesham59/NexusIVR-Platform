        <url-pattern>/api/v1/admin/calls-per-day</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>SuperAdminDashboardServlet</servlet-name>
        <url-pattern>/api/v1/admin/latest-companies</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
